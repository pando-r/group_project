# 二选一：取消下行注释使用 PostgreSQL 16（需先执行 backend/scripts/init_postgres.sql）；
# 保持注释则回退到 backend/medrisk_dev.db（SQLite，零依赖演示）。
# DATABASE_URL=postgresql+asyncpg://medrisk:medrisk@127.0.0.1:5432/medrisk

APP_ENV=development
SECRET_KEY=change-me-in-production-use-at-least-32-random-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
AUTO_CREATE_TABLES=true
AUTO_SEED=true

# 允许逗号分隔；Vite 开发服务器已通过代理，通常无需直连
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Agent / LLM
# LLM_MOCK=1：完全离线，不产生任何外部请求。
# LLM_MOCK=0：调用 DeepSeek（OpenAI 兼容端点），必须先脱敏并完成供应商合规确认。
# 供应商须承诺不将请求数据用于训练，或改用私有化部署端点。
LLM_MOCK=1
LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=
LLM_MODEL=deepseek-flash
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=2048
# 结构化报告默认关闭思考模式，降低延迟与不确定性
LLM_THINKING=0
LLM_BACKOFF_SECONDS=0.5
# 默认关闭 LangSmith 等第三方追踪，避免提示词外发
LLM_TRACING=0
